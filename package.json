{
  "name": "benchwire",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "npm run build:app && node server/http.ts",
    "check": "npm run typecheck && npm test && npm run gate",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.app.json",
    "test": "node --test \"**/*.test.ts\"",
    "gate": "node tools/gate.ts",
    "build:app": "vite build app --outDir ../dist/app --emptyOutDir",
    "test:ui": "node --test app/canvas.ui.ts",
    "perf": "node --test app/canvas.perf.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "zod": "4.6.7"
  }
}
